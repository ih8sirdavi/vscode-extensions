{
  "name": "vscode-master-collection",
  "displayName": "VS Code Master Collection",
  "description": "Complete collection of essential VS Code extensions for development. Each collection automatically installs its required extensions.",
  "version": "0.0.0",
  "publisher": "ih8sirdavi",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ih8sirdavi/vscode-extensions.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Extension Packs"
  ],
  "extensionPack": [
    "${publisher}.core-dev-essentials",
    "${publisher}.python-dev-essentials",
    "${publisher}.documentation-essentials"
  ],
  "scripts": {
    "prepare": "node scripts/check-package-manager.js",
    "setup": "pnpm install || npm install",
    "cleanup": "node scripts/cli.js cleanup",
    "cleanup:force": "node scripts/cli.js cleanup --force",
    "publish": "node scripts/cli.js publish",
    "publish:force": "node scripts/cli.js publish --force",
    "remote:dev": "node scripts/cli.js remote",
    "remote:prod": "node scripts/cli.js remote --production",
    "package": "pnpm -r exec vsce package --allow-missing-repository || npm run package --workspaces",
    "test": "pnpm -r exec code --install-extension *.vsix || npm run test --workspaces"
  },
  "workspaces": [
    "core-dev-essentials",
    "python-dev-essentials",
    "documentation-essentials"
  ],
  "license": "MIT",
  "keywords": [
    "vscode",
    "extensions",
    "development",
    "python",
    "documentation",
    "productivity",
    "complete"
  ],
  "homepage": "https://github.com/ih8sirdavi/vscode-extensions#readme",
  "bugs": {
    "url": "https://github.com/ih8sirdavi/vscode-extensions/issues"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0",
    "dotenv": "^16.4.7"
  }
}
